#!/bin/sh
# =============================================================================
# S98apstart —— 开机自启小车 AP 热点（自包含：hostapd + dnsmasq）
#
# 用法:
#   S98apstart {start|stop|restart|status}      # 无参数 = start
#
# 行为:
#   - 配置全部显式来自 /etc/smartcar-ap.conf，脚本没有内置默认；配置缺失/非法
#     直接报错。AP_IFACE 不存在（如 Nano-E 没有 WiFi 硬件）时 start 跳过 exit 0;
#   - SSID = <AP_SSID_PREFIX>-<MAC 后 4 位>（多车唯一），WPA2 加密
#     （AP_PASS 显式置空 = 开放热点，仅调试用）;
#   - 生成 /etc/hostapd.smartcar.conf 与 /etc/dnsmasq.smartcar.conf：
#     AP 地址 = AP_IP（默认配置为 192.168.1.2/24，和网口一致），
#     DHCP 池固定 .128-.191（/26），DNS 域名 car 指向 AP;
#   - 和 eth0 同网段同地址时的路由处理（内核同前缀 /24 只会走一条路由）：
#       * wlan0 的 /24 路由降为 metric 1000 → eth0（调试口）优先;
#       * 给 DHCP 池 .128/26 装静态路由走 wlan0 → 客户端流量精确走 AP;
#   - 起热点前清掉该接口上残留的 STA（wpa_supplicant/udhcpc/dhcpcd）和旧的
#     hostapd/dnsmasq/udhcpd，配静态 IP，最后校验进程真的活着。
#
# 配置: /etc/smartcar-ap.conf（模板见仓库 scripts/smartcar-ap.conf，flash.sh 负责部署）
# 必填: AP_IFACE AP_IP AP_SSID_PREFIX AP_PASS AP_CHANNEL AP_COUNTRY
#
# 部署: flash.sh → /etc/init.d/S98apstart
# =============================================================================
set -u
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

AP_CONF=/etc/smartcar-ap.conf
HOSTAPD_CONF=/etc/hostapd.smartcar.conf
DNSMASQ_CONF=/etc/dnsmasq.smartcar.conf
HOSTAPD_PID=/var/run/hostapd.smartcar.pid
DNSMASQ_PID=/var/run/dnsmasq.smartcar.pid

log() {
    echo "[ap] $*"
    command -v logger >/dev/null 2>&1 && logger -t smartcar-ap "$*" 2>/dev/null
}
die() {
    echo "[ap] 错误: $*" >&2
    command -v logger >/dev/null 2>&1 && logger -t smartcar-ap "错误: $*" 2>/dev/null
    exit 1
}
is_alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }

# ── 配置：全部显式来自 $AP_CONF（脚本无内置默认）──────────────────────────
[ -f "$AP_CONF" ] || die "缺少 $AP_CONF（应由 flash.sh 部署）"
. "$AP_CONF"
[ -n "${AP_IFACE:-}" ]       || die "$AP_CONF 缺少 AP_IFACE"
[ -n "${AP_IP:-}" ]          || die "$AP_CONF 缺少 AP_IP"
[ -n "${AP_SSID_PREFIX:-}" ] || die "$AP_CONF 缺少 AP_SSID_PREFIX"
[ -n "${AP_CHANNEL:-}" ]     || die "$AP_CONF 缺少 AP_CHANNEL"
[ -n "${AP_COUNTRY:-}" ]     || die "$AP_CONF 缺少 AP_COUNTRY"
[ -n "${AP_PASS+x}" ]        || die "$AP_CONF 缺少 AP_PASS（不需要密码就显式写 AP_PASS=）"
case "$AP_IP" in
    *.*.*.*) ;;
    *) die "AP_IP=$AP_IP 不是 IPv4 地址" ;;
esac

# 接口不存在（如 Nano-E 没有 WiFi 硬件）时返回 1
iface_present() { [ -d "/sys/class/net/$AP_IFACE" ]; }

# 本机 AP 组件（hostapd/dnsmasq/udhcpd）都按名清理
stop_daemons() {
    for f in "$HOSTAPD_PID" "$DNSMASQ_PID"; do
        [ -f "$f" ] || continue
        p=$(cat "$f" 2>/dev/null || :)
        is_alive "$p" && kill "$p" 2>/dev/null
        rm -f "$f"
    done
    killall hostapd 2>/dev/null
    killall dnsmasq 2>/dev/null
    killall udhcpd 2>/dev/null
    return 0
}

# 只清指定接口上的 STA 客户端，别误伤 eth0 的 udhcpc
stop_sta() {
    wpa_cli -p /var/run/wpa_supplicant -i "$AP_IFACE" terminate >/dev/null 2>&1
    for p in $(ps w 2>/dev/null | grep -v grep | grep "wpa_supplicant .*-i $AP_IFACE" | awk '{print $1}'); do
        kill "$p" 2>/dev/null
    done
    for p in $(ps w 2>/dev/null | grep -v grep | grep "udhcpc .*-i $AP_IFACE" | awk '{print $1}'); do
        kill "$p" 2>/dev/null
    done
    command -v dhcpcd >/dev/null 2>&1 && dhcpcd -k "$AP_IFACE" >/dev/null 2>&1
    return 0
}

# AP 是静态地址，别让 dhcpcd 再来要 DHCP 落一个 169.254 地址
deny_dhcpcd() {
    command -v dhcpcd >/dev/null 2>&1 || return 0
    [ -f /etc/dhcpcd.conf ] || : > /etc/dhcpcd.conf
    grep -qE "^[[:space:]]*denyinterfaces.*[[:space:]]$AP_IFACE([[:space:]]|$)" /etc/dhcpcd.conf ||
        echo "denyinterfaces $AP_IFACE" >> /etc/dhcpcd.conf
    return 0
}

write_configs() {
    mac=$(cat "/sys/class/net/$AP_IFACE/address" 2>/dev/null | tr -d ':\n')
    suffix=$(printf '%s' "$mac" | tail -c 4)
    case "$suffix" in
        [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;;
        *) die "读不到 $AP_IFACE 的 MAC 地址" ;;
    esac
    SSID="$AP_SSID_PREFIX-$suffix"
    if [ -n "$AP_PASS" ]; then
        n=${#AP_PASS}
        [ "$n" -ge 8 ] && [ "$n" -le 63 ] || die "AP_PASS 需 8..63 字符（当前 $n）"
    else
        log "警告: AP_PASS 为空 → 开放热点（仅调试；生产请设置密码）"
    fi

    ip_prefix=${AP_IP%.*}

    {
        echo "# 由 S98apstart 生成，请勿手改；改配置请编辑 /etc/smartcar-ap.conf 后 restart"
        echo "interface=$AP_IFACE"
        echo "driver=nl80211"
        echo "ctrl_interface=/var/run/hostapd"
        echo "ctrl_interface_group=0"
        echo "ssid=$SSID"
        echo "country_code=$AP_COUNTRY"
        echo "hw_mode=g"
        echo "channel=$AP_CHANNEL"
        echo "beacon_int=100"
        echo "dtim_period=2"
        echo "max_num_sta=8"
        echo "auth_algs=1"
        echo "wmm_enabled=1"
        echo "ieee80211n=1"
        if [ -n "$AP_PASS" ]; then
            echo "wpa=2"
            echo "wpa_passphrase=$AP_PASS"
            echo "wpa_key_mgmt=WPA-PSK"
            echo "rsn_pairwise=CCMP"
        fi
    } > "$HOSTAPD_CONF"

    cat > "$DNSMASQ_CONF" <<EOF
# 由 S98apstart 生成，请勿手改
interface=$AP_IFACE
bind-interfaces
# DHCP 池固定 .128-.191(/26)：客户端靠 S98apstart 装的 /26 路由精确走 wlan0
dhcp-range=$ip_prefix.128,$ip_prefix.191,255.255.255.0,12h
dhcp-option=3,$AP_IP
dhcp-option=6,$AP_IP
address=/car/$AP_IP
EOF
}

start() {
    [ "$(id -u)" = 0 ] || die "需要 root 运行"
    if ! iface_present; then
        log "接口 $AP_IFACE 不存在（Nano-E 无 WiFi 硬件？），跳过"
        exit 0
    fi
    [ -d "/sys/class/net/$AP_IFACE/wireless" ] || die "$AP_IFACE 不是无线接口"

    write_configs
    log "启动 AP: 接口=$AP_IFACE SSID=$SSID 地址=$AP_IP 信道=$AP_CHANNEL"

    stop_daemons
    stop_sta
    deny_dhcpcd

    ip route flush dev "$AP_IFACE" 2>/dev/null
    ip addr flush dev "$AP_IFACE" 2>/dev/null
    ip link set dev "$AP_IFACE" up || die "无法拉起 $AP_IFACE"
    ip -4 addr add "$AP_IP/24" dev "$AP_IFACE" || die "设置 $AP_IFACE 地址失败"

    # 同网段路由处理：/24 降级让 eth0 优先；客户端池 /26 精确走 AP
    ip_prefix=${AP_IP%.*}
    ip route del "$ip_prefix.0/24" dev "$AP_IFACE" 2>/dev/null
    ip route replace "$ip_prefix.0/24" dev "$AP_IFACE" src "$AP_IP" metric 1000 ||
        die "设置 $AP_IFACE /24 路由失败"
    ip route replace "$ip_prefix.128/26" dev "$AP_IFACE" src "$AP_IP" ||
        die "设置 $AP_IFACE 客户端路由失败"

    eth_ip=$(ip -4 addr show dev eth0 2>/dev/null | sed -n 's/^ *inet \([0-9.]*\)\/.*/\1/p' | head -n1)
    if [ -n "$eth_ip" ] && [ "$eth_ip" != "$AP_IP" ]; then
        log "提示: eth0=$eth_ip 与 AP_IP=$AP_IP 不一致（可写 /etc/smartcar-ap.conf 对齐）"
    fi

    dnsmasq --conf-file="$DNSMASQ_CONF" --pid-file="$DNSMASQ_PID" || die "dnsmasq 启动失败（logread | tail 看原因）"
    hostapd -B -P "$HOSTAPD_PID" "$HOSTAPD_CONF" || die "hostapd 启动失败（logread | tail 看原因）"

    # hostapd -B 先返回、后初始化：等一下并确认进程没死
    i=0
    while [ "$i" -lt 25 ]; do
        p=$(cat "$HOSTAPD_PID" 2>/dev/null || :)
        is_alive "$p" && break
        sleep 0.2
        i=$((i+1))
    done
    p=$(cat "$HOSTAPD_PID" 2>/dev/null || :)
    d=$(cat "$DNSMASQ_PID" 2>/dev/null || :)
    if ! is_alive "$p" || ! is_alive "$d"; then
        stop_daemons
        die "AP 组件没存活（驱动不支持 AP？看 logread | tail）"
    fi

    echo "✅ 热点已启动: $SSID"
    if [ -n "$AP_PASS" ]; then
        echo "   密码: $AP_PASS  (WPA2)"
    else
        echo "   密码: 无（开放热点，仅调试）"
    fi
    echo "   手机连上后打开: http://$AP_IP/"
}

stop() {
    if ! iface_present; then
        log "接口 $AP_IFACE 不存在，无需停止"
        return 0
    fi
    log "停止 AP（$AP_IFACE）"
    stop_daemons
    ip route flush dev "$AP_IFACE" 2>/dev/null
    ip addr flush dev "$AP_IFACE" 2>/dev/null
    log "已停止"
}

status() {
    if ! iface_present; then
        echo "[ap] 接口 $AP_IFACE 不存在（Nano-E 无 WiFi 硬件？）"
        return 0
    fi
    echo "[ap] 接口: $AP_IFACE"
    ip -4 addr show dev "$AP_IFACE" 2>/dev/null |
        sed -n 's/^ *inet \([0-9.]*\/[0-9]*\).*/[ap]   IPv4: \1/p'
    hp=$(cat "$HOSTAPD_PID" 2>/dev/null || :)
    dp=$(cat "$DNSMASQ_PID" 2>/dev/null || :)
    is_alive "$hp" && echo "[ap] hostapd: 运行中 (pid $hp)" || echo "[ap] hostapd: 未运行"
    is_alive "$dp" && echo "[ap] dnsmasq: 运行中 (pid $dp)" || echo "[ap] dnsmasq: 未运行"
    [ -f "$HOSTAPD_CONF" ] && sed -n 's/^ssid=//p' "$HOSTAPD_CONF" | sed 's/^/[ap] SSID: /'
    if is_alive "$hp" && command -v hostapd_cli >/dev/null 2>&1; then
        n=$(hostapd_cli -p /var/run/hostapd -i "$AP_IFACE" all_sta 2>/dev/null | grep -c '^[0-9a-fA-F]' || true)
        echo "[ap] 已连客户端: ${n:-0}"
    fi
    return 0
}

case "${1:-start}" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; start ;;
    status)  status ;;
    *)       echo "用法: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
